import argparse
import random
import tflite

parser = argparse.ArgumentParser(formatter_class=argparse.ArgumentDefaultsHelpFormatter)
parser.add_argument('--model', help='flatbuffer model name',default='mnist_model')
parser.add_argument('--clk', help='FPGA clock rate',default=500e6, type=float)
parser.add_argument('--fps', help='first layer input shape arrival rate',default=100., type=float)
args = parser.parse_args()
print(args)

with open('./{}.tflite'.format(args.model), 'rb') as f:
    buf = f.read()
    model = tflite.Model.GetRootAsModel(buf, 0)

graph = model.Subgraphs(0)
for j in range(graph.OperatorsLength()):
    #print('opcode_index',graph.Operators(j).OpcodeIndex())
    print('opcode',model.OperatorCodes(graph.Operators(j).OpcodeIndex()).BuiltinCode(), 'CONV_2D',tflite.BuiltinOperator.CONV_2D,'RESHAPE',tflite.BuiltinOperator.RESHAPE)
    #op_code = model.OperatorCodes(op.OpcodeIndex())

    # The first operator is a convolution.
    #assert(op_code.BuiltinCode() == tflite.BuiltinOperator.CONV_2D)
    #print('options',graph.Operators(j).BuiltinOptions())
    for i in range(graph.Operators(j).InputsLength()):
        #print('input','j',j,'i',i,graph.Operators(j).Inputs(i))
        tensor = graph.Tensors(graph.Operators(j).Inputs(i))
        #print('input',tensor.ShapeAsNumpy())
        buf = model.Buffers(tensor.Buffer())
        npa = buf.DataAsNumpy()
        print('input',tensor.ShapeAsNumpy(),npa)
    for i in range(graph.Operators(j).OutputsLength()):
        #print('output','j',j,'i',i,graph.Operators(j).Outputs(i))
        tensor = graph.Tensors(graph.Operators(j).Outputs(i))
        buf = model.Buffers(tensor.Buffer())
        npa = buf.DataAsNumpy()
        print('output',tensor.ShapeAsNumpy(),npa)
#print(dir(graph.Operators(0)))
#print(dir(model))
exit()

print(graph.OperatorsLength())
exit()
